{
  "openapi": "3.1.0",
  "info": {
    "title": "MDF R3 A1 read-only management",
    "version": "r3-a1-r1"
  },
  "paths": {
    "/management": {
      "get": {
        "summary": "Management",
        "operationId": "management_directory",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagementDTO"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagementErrorDTO"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagementErrorDTO"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BindingContractDTO-Input": {
        "properties": {
          "identity": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Identity"
          },
          "revision": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Revision"
          },
          "source": {
            "$ref": "#/components/schemas/ContractKeyDTO"
          },
          "mappings": {
            "items": {
              "$ref": "#/components/schemas/MappingDTO"
            },
            "type": "array",
            "maxItems": 16,
            "minItems": 1,
            "title": "Mappings"
          },
          "compatibility_policy": {
            "type": "string",
            "title": "Compatibility Policy"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Limitations"
          },
          "silent_fallback": {
            "type": "boolean",
            "const": false,
            "title": "Silent Fallback",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "identity",
          "revision",
          "source",
          "mappings",
          "compatibility_policy",
          "limitations"
        ],
        "title": "BindingContractDTO"
      },
