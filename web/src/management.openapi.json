      "ContractKeyDTO": {
        "properties": {
          "identity": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Identity"
          },
          "revision": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["identity", "revision"],
        "title": "ContractKeyDTO"
      },
      "DirectoryEntryDTO-Input": {
        "properties": {
          "identity": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "title": "Identity"
          },
          "domain": {
            "type": "string",
            "enum": ["Macro", "TDX", "KD"],
            "title": "Domain"
          },
          "source_name": {
            "type": "string",
            "title": "Source Name"
          },
          "component_identity": {
            "type": "string",
            "title": "Component Identity"
          },
          "capability_identity": {
            "type": "string",
            "title": "Capability Identity"
          },
          "operation": {
            "type": "string",
            "title": "Operation"
          },
          "code_delivery": {
            "type": "string",
            "enum": ["DELIVERED", "CONTRACT_ONLY"],
            "title": "Code Delivery"
          },
          "contract_disposition": {
            "type": "string",
            "enum": [
              "BOUNDED_CONTRACT",
              "CANDIDATE",
              "NOT_ADMITTED_SELF_BLOCKED"
            ],
            "title": "Contract Disposition"
          },
          "source_contract": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceContractDTO"
              },
              {
                "type": "null"
              }
            ]
          },
          "binding_contract": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BindingContractDTO-Input"
              },
              {
                "type": "null"
              }
            ]
          },
          "asset": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ContractKeyDTO"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_qualified_contract": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Qualified Contract"
          },
          "web_read": {
            "type": "string",
            "enum": [
              "CPI_REQUEST_QUALIFIED",
              "DOMAIN_SPECIFIC_ONLY",
              "UNSUPPORTED"
            ],
            "title": "Web Read"
          },
          "source_qualification": {
            "type": "string",
            "const": "UNKNOWN",
            "title": "Source Qualification",
            "default": "UNKNOWN"
          },
          "current_binding": {
            "type": "string",
            "const": "UNKNOWN",
            "title": "Current Binding",
            "default": "UNKNOWN"
          },
          "runtime_observation": {
            "type": "string",
            "const": "UNKNOWN",
            "title": "Runtime Observation",
            "default": "UNKNOWN"
          },
          "local_holding": {
            "type": "string",
            "const": "UNKNOWN",
            "title": "Local Holding",
            "default": "UNKNOWN"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 40,
            "minItems": 1,
            "title": "Reasons"
          },
          "evidence_refs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "title": "Evidence Refs"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "identity",
          "domain",
          "source_name",
          "component_identity",
          "capability_identity",
          "operation",
          "code_delivery",
          "contract_disposition",
          "source_contract",
          "binding_contract",
          "asset",
          "source_qualified_contract",
          "web_read",
          "reasons",
          "evidence_refs"
        ],
        "title": "DirectoryEntryDTO"
      },
