              }
            ]
          },
          "asset": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ContractKeyDTO"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_qualified_contract": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Qualified Contract"
          },
          "web_read": {
            "type": "string",
            "enum": [
              "CPI_REQUEST_QUALIFIED",
