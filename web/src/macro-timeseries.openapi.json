      "get": {
        "summary": "Timeseries Query",
        "operationId": "timeseries_query_api_r5_employment_timeseries_query_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "start",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            },
            "description": "Inclusive reference month YYYY-MM."
          },
          {
            "in": "query",
            "name": "end",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            },
            "description": "Inclusive reference month YYYY-MM; descending result presentation."
          },
          {
            "in": "query",
            "name": "local_only",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "true/false; CPI default true, other families false. History always local; GET never writes."
          },
          {
            "in": "query",
            "name": "query_mode",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "current/history; inferred history with as_of or available basis."
          },
          {
            "in": "query",
            "name": "as_of",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Aware ISO8601 inclusive MDF cutoff; every operand and comparison uses this same cutoff. +08:00 is accepted."
          },
          {
            "in": "query",
            "name": "as_of_basis",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "observed/available; history defaults available. Must agree with vintage_mode."
          },
          {
            "in": "query",
            "name": "vintage_mode",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Alias of as_of_basis. Never official vintage."
          },
          {
            "in": "query",
            "name": "columns",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional comma-separated numeric fields: value,net_change_1m_thousand_jobs,change_1m_percentage_points,change_1m_hours,mom_pct,yoy_pct,change_1m_ratio,change_12m_ratio. Omitted preserves existing fields and metadata."
          },
          {
            "in": "query",
            "name": "series",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "CSV allowlisted CES/CPS IDs; omitted preserves original five. Includes private/EPOP/eleven non-overlapping major sectors; no summation of aggregates."
          },
          {
            "in": "query",
            "name": "measure",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "index only; native value and per-series units, not a price index."
          }
        ]
      }
