      "post": {
        "summary": "Submit",
        "operationId": "submit_api_r5_cpi_timeseries_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "request_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "action": {
                    "type": "string",
                    "enum": ["init", "initialize", "update"]
                  },
                  "start": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
                  },
                  "end": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
                  },
                  "series": {
                    "type": "string",
                    "description": "Optional allowlisted CSV subset; omitted collects every profile input. Use only newly admitted IDs for historical backfill."
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": ["request_id", "action", "start", "end"]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
