{
  "name": "mdf-r5-cpi-readonly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "contract": "openapi-typescript openapi.json -o src/api.generated.ts && prettier --write src/api.generated.ts",
    "check": "tsc -b",
    "format:check": "prettier --check src scripts vite.config.ts tsconfig.json package.json index.html",
    "contract:check": "node scripts/check-contract.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "27.0.1",
    "openapi-typescript": "7.10.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
