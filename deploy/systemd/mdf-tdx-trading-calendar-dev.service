[Unit]
Description=MDF DEV unified A-share trading calendar
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=MDF_TDX_CALENDAR_PROJECT=/srv/market-data-foundation
Environment=MDF_TDX_CALENDAR_GOVERNMENT_URL=
EnvironmentFile=-/etc/mdf/tdx-trading-calendar.env
StateDirectory=mdf-tdx-trading-calendar
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ExecStart=/usr/local/bin/uv run --project ${MDF_TDX_CALENDAR_PROJECT} --locked python ${MDF_TDX_CALENDAR_PROJECT}/scripts/mdf_tdx_trading_calendar.py --dev-opt-in --publish --artifact-dir %S/mdf-tdx-trading-calendar --government-url=${MDF_TDX_CALENDAR_GOVERNMENT_URL}
